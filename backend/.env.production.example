# ── MChart backend — production template ───────────────────────────────
# Copy to .env on the server, fill the blanks, then:
#   php artisan key:generate
#   php artisan migrate --force --seed
#   php artisan config:cache

APP_NAME=MChart
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://chart.mbuniehub.com
FRONTEND_URL=https://chart.mbuniehub.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# ── Database (cPanel → MySQL Databases) ──────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u125644160_mchart
DB_USERNAME=u125644160_mchart
DB_PASSWORD=

# InnoDB is forced in config/database.php regardless of the server default.

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# ── Queue: a worker process handles notification / push jobs ─────────
QUEUE_CONNECTION=database

# ── Real-time: Laravel Reverb behind an Apache WebSocket proxy ───────
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=mchart
REVERB_APP_KEY=CHANGE_ME_LONG_RANDOM_KEY
REVERB_APP_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
REVERB_HOST=chart.mbuniehub.com
REVERB_PORT=443
REVERB_SCHEME=https
# Where the reverb process actually binds (proxied to by Apache):
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

# Client-side (Flutter build) uses these:
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ── Push notifications (optional; log driver until FCM is configured) ─
PUSH_DRIVER=log
FCM_CREDENTIALS_PATH=storage/app/firebase/service-account.json

# ── Mail (fill with the host's SMTP or a provider) ──────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@mbuniehub.com"
MAIL_FROM_NAME="${APP_NAME}"

CACHE_STORE=database
FILESYSTEM_DISK=local
