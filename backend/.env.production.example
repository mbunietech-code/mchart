# ── MChart backend — production template ───────────────────────────────
# Copy to .env on the server, fill the blanks, then:
#   php artisan key:generate
#   php artisan migrate --force --seed
#   php artisan mchart:admin you@example.com --name="Your Name"   # set a real admin
#   php artisan config:cache && php artisan route:cache && php artisan event:cache
#
# Shared-host notes (Hostinger etc.): exec()/shell_exec() are usually disabled,
# so `php artisan storage:link` fails and `tinker` won't start — see docs/DEPLOYMENT.md.

APP_NAME=MChart
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://chart.mbuniehub.com
FRONTEND_URL=https://chart.mbuniehub.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

# ── Database (hPanel → Databases → MySQL) ────────────────────────────
# Use "localhost" (socket) on shared hosts — user grants are @localhost,
# and 127.0.0.1 (TCP) is often refused.
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# InnoDB is forced in config/database.php regardless of the server default.

# ── Cache / session / queue ─────────────────────────────────────────
# file-based avoids hammering a connection-limited MySQL on every request.
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true

# sync = jobs run inline (no worker/cron needed). Switch to "database" + a
# cron worker once real-time (Pusher) is on and volume grows.
QUEUE_CONNECTION=sync

# ── Real-time broadcasting ──────────────────────────────────────────
# "log" = no-op (notifications still persist + push). Shared hosting cannot
# run Laravel Reverb; use Pusher for live channels (see docs/DEPLOYMENT.md §8).
BROADCAST_CONNECTION=log

# --- Reverb (only on a VPS / plan that allows a persistent process) ---
# BROADCAST_CONNECTION=reverb
REVERB_APP_ID=mchart
REVERB_APP_KEY=CHANGE_ME_LONG_RANDOM_KEY
REVERB_APP_SECRET=CHANGE_ME_LONG_RANDOM_SECRET
REVERB_HOST=chart.mbuniehub.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8080

# --- Pusher (shared-hosting real-time) ---
# BROADCAST_CONNECTION=pusher
# PUSHER_APP_ID=
# PUSHER_APP_KEY=
# PUSHER_APP_SECRET=
# PUSHER_APP_CLUSTER=eu

# ── Push notifications ──────────────────────────────────────────────
PUSH_DRIVER=log
FCM_CREDENTIALS_PATH=storage/app/firebase/service-account.json

# ── Mail (fill with the host's SMTP) ───────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@mbuniehub.com"
MAIL_FROM_NAME="${APP_NAME}"

FILESYSTEM_DISK=local
