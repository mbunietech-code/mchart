# MChart Flutter web client

# Hostinger/LiteSpeed serves .wasm as text/plain by default. The browser's
# WebAssembly.compileStreaming (used by CanvasKit) requires the response's
# Content-Type to be exactly application/wasm and rejects otherwise — without
# this, the app fails to start on every browser regardless of anything else.
<IfModule mod_mime.c>
  AddType application/wasm .wasm
</IfModule>

# SPA fallback so deep links (e.g. /tasks/5) and page refreshes resolve to
# index.html instead of a 404.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# Cache policy: index.html, flutter_bootstrap.js and main.dart.js must always
# be revalidated — each deploy replaces them in place (no content hash in the
# filename), so a long-lived cache (e.g. Cloudflare's proxy cache, which
# otherwise defaults to 7 days for .js) would keep serving a stale build.
<IfModule mod_headers.c>
  <FilesMatch "\.(html|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(png|jpg|jpeg|svg|ico|woff2?|ttf|otf|wasm)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
